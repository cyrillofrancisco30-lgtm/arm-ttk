if [[ -z "$GITHUB_TOKEN" ]]; then
  echo "Erro: exporte GITHUB_TOKEN antes de usar."
  exit 1
fi

API="https://api.github.com/repos/${OWNER}/${REPO}/actions/workflows/${WF}/dispatches"

resp=$(curl -s -w "\n%{http_code}" -X POST \
  -H "Accept: application/vnd.github+json" \
  -H "Authorization: token ${GITHUB_TOKEN}" \
  -d "{\"ref\":\"${BRANCH}\"}" \
  "$API")

body=$(echo "$resp" | head -n -1)
code=$(echo "$resp" | tail -n1)

if [[ $code == 201 || $code == 202 ]]; then
  echo "✅ workflow disparado (HTTP $code)"
else
  echo "❌ falha (HTTP $code)"
  echo "$body"
  exit 1
fi



chmod +x trigger-workflow.sh
export GITHUB_TOKEN=ghp_SEU_TOKEN_AQUI
