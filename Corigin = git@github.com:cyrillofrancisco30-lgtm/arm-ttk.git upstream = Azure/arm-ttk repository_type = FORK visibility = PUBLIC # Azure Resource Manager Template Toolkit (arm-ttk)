# Salve como Trigger-Workflow.ps1
$owner   = "cyrillofrancisco30"
$repo    = "my-api"
$wfFile  = "cyrillofrancisco30-lgtm.yml"
$ref     = "main"

$token = $env:GITHUB_TOKEN
if (-not $token) {
    Write-Error "Defina `$env:GITHUB_TOKEN antes de executar."
    exit 1
}

$uri = "https://api.github.com/repos/$owner/$repo/actions/workflows/$wfFile/dispatches"
$body = @{ ref = $ref } | ConvertTo-Json
$headers = @{
    "Accept"        = "application/vnd.github+json"
    "Authorization" = "token $token"
}

try {
    Invoke-RestMethod -Method Post -Uri $uri -Headers $headers -Body $body -ErrorAction Stop
    Write-Host "✅ workflow disparado"
}
catch {
    Write-Error "❌ falha ao chamar a API"
    Write-Error $_.Exception.Response.StatusCode.Value__
}


$env:GITHUB_TOKEN = "ghp_SEU_TOKEN_AQUI"
.\Trigger-Workflow.ps1



