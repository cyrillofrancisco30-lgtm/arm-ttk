# Salve o script abaixo como trigger-workflow.sh
#!/usr/bin/env bash
OWNER="cyrillofrancisco30"
REPO="my-api"
WF="cyrillofrancisco30-lgtm.yml"
BRANCH="main"

if [[ -z "$GITHUB_TOKEN" ]]; then
  echo "Erro: exporte GITHUB_TOKEN antes de usar."
  exit 1
fi

API="https://api.github.com/repos/${OWNER}/${REPO}/actions/workflows/${WF}/dispatches"

resp=$(curl -s -w "\n%{http_code}" -X POST \
  -H "Accept: application/vnd.github+json" \
  -H "Authorization: token ${GITHUB_TOKEN}" \
  -d "{\"ref\":\"${BRANCH}\"}" \
  "$API")

body=$(echo "$resp" | head -n -1)
code=$(echo "$resp" | tail -n1)

if [[ $code == 201 || $code == 202 ]]; then
  echo "✅ workflow disparado (HTTP $code)"
else
  echo "❌ falha (HTTP $code)"
  echo "$body"
  exit 1
fi



chmod +x trigger-workflow.sh
export GITHUB_TOKEN=ghp_SEU_TOKEN_AQUI
./trigger-workflow.sh



# Salve como Trigger-Workflow.ps1
$owner   = "cyrillofrancisco30"
$repo    = "my-api"
$wfFile  = "cyrillofrancisco30-lgtm.yml"
$ref     = "main"

$token = $env:GITHUB_TOKEN
if (-not $token) {
    Write-Error "Defina `$env:GITHUB_TOKEN antes de executar."
    exit 1
}

$uri = "https://api.github.com/repos/$owner/$repo/actions/workflows/$wfFile/dispatches"
$body = @{ ref = $ref } | ConvertTo-Json
$headers = @{
    "Accept"        = "application/vnd.github+json"
    "Authorization" = "token $token"
}

try {
    Invoke-RestMethod -Method Post -Uri $uri -Headers $headers -Body $body -ErrorAction Stop
    Write-Host "✅ workflow disparado"
}
catch {
    Write-Error "❌ falha ao chamar a API"
    Write-Error $_.Exception.Response.StatusCode.Value__
}


$env:GITHUB_TOKEN = "ghp_SEU_TOKEN_AQUI"
.\Trigger-Workflow.ps1



